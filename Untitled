
select 
  e.EmployeeID,
  e.Name,
  e.Department,
  count(o.OrderID) as totalorders,
  count(
    distinct case
    when oi.totalamt > 5000 then oi.orderId
    end
  ) as morethan5000,
  sum(oi.totalamt) as totalsales
from `e1.employees` as e
inner join `e1.orders` as o
on e.EmployeeID = o.EmployeeID
inner join( 
  select
    OrderID,
    sum(Total) as totalamt
  from `e1.order_items`
  group by OrderID

) as oi
on o.OrderID = oi.orderid
group by 
  e.EmployeeID,
  e.Name,
  e.Department
having morethan5000 > 5
order by totalsales desc;

-- For every employee, calculate:

-- EmployeeID
-- Employee name
-- Department
-- Number of orders handled
-- Number of different customers served

-- Display only employees who have handled more than 5 orders.

-- Sort employees by number of orders handled from highest to lowest.



select 
  e.EmployeeID,
  e.Name,
  e.Department,
  count(distinct o.OrderID) as nooforders,
  count(distinct o.CustomerID) as no_of_customers
from `e1.employees` as e
inner join `e1.orders` as o
on e.EmployeeID = o.EmployeeID

group by 
  e.EmployeeID,
  e.Name,
  e.Department
having nooforders >= 5
order by nooforders desc



-- For every city, calculate:

-- Number of customers
-- Number of orders
-- Total sales value
-- Average order-item value

-- Display only cities where the total sales value is greater than ₹3,00,000.

-- Sort cities by total sales in descending order.
select * from `e1.order_items`

select 
c.City,
count(distinct c.CustomerID) as no_of_customer,
count(distinct o.OrderID) as no_of_orders,
sum(oi.Total) as totalamt,
avg(oi.SellingPrice) as avg_selling_price
from `e1.customers` as c
inner join `e1.orders` as o
on c.CustomerID = o.CustomerID
inner join `e1.order_items` as oi
on oi.OrderID = o.OrderID
group by c.City
having totalamt > 300000
order by totalamt desc


-- For every product that has been sold, calculate:

-- ProductID
-- ProductName
-- Number of orders containing the product
-- Total quantity sold
-- Average selling price

-- Display only products whose average selling price is greater than ₹15,000.

-- Show the highest average selling price first.



select 
  p.ProductID,
  p.ProductName,
  count(distinct o.OrderID) as totalorders,
  sum(oi.Quantity) as total_quantity,
  avg(oi.SellingPrice) as avg_selling_pricce
from `e1.products` as p
inner join `e1.order_items` as oi
on p.ProductID = oi.ProductID
inner join `e1.orders` as o
on o.OrderID = oi.OrderID
group by 
 p.ProductID,
 p.ProductName  
having avg_selling_pricce > 1500
order by avg_selling_pricce desc



